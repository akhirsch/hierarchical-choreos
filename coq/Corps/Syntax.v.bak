    (*           rewrite (subst_ext (fun n => substup σ (renup ξ n)) (substup (fun n => σ (ξ n))) *)
    (*                      (substup_renup_fusion ξ σ) e) *)
    (*       end. *)
    (* Qed. *)
    
    (* Lemma subst_ren_fusion : forall e σ ξ, *)
    (*     ren (subst e σ) ξ = subst e (fun n => ren (σ n) ξ). *)
    (* Proof using. *)
    (*   intro e; induction e; intros σ ξ; cbn; *)
