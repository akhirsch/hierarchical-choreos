Require Import Base.EqBool.
From Stdlib Require Import Lists.List.
From Stdlib Require Import Lia.
From Stdlib Require Import Classes.RelationClasses.
Import ListNotations.
From Stdlib Require Import Logic.JMeq.
From Stdlib Require Import Logic.Eqdep_dec.
From Stdlib Require Import Program.Equality.
From Stdlib Require Import Program.Wf.

Require Import Modalities.

Set Implicit Arguments.
Section CorpsSyntax.

  Context {PName : Type} `{EqBool PName}.
  #[local] Notation mod := (@mod PName).
  #[local] Definition ptm := @proc_to_mod PName.
  #[local] Definition PrefixOfT := @PrefixOfT PName.
  Coercion ptm : PName >-> mod.

  Section CorpsTypes.

    Inductive type : Type :=
      UnitT
    | VoidT
    | AtT : PName -> type -> type
    | TimesT : type -> type -> type
    | PlusT : type -> type -> type
    | ArrT : type -> type -> type.

    Fixpoint typ_eqb (t1 t2 : type) : bool :=
      match t1, t2 with
      | UnitT, UnitT => true
      | VoidT, VoidT => true
      | AtT p t1, AtT q t2 => eqb p q && typ_eqb t1 t2
      | TimesT t11 t12, TimesT t21 t22 => typ_eqb t11 t21 && typ_eqb t12 t22
      | PlusT t11 t12, PlusT t21 t22 => typ_eqb t11 t21 && typ_eqb t12 t22
      | ArrT t11 t12, ArrT t21 t22 => typ_eqb t11 t21 && typ_eqb t12 t22
      | _, _ => false
      end.

    #[global] Program Instance TypEqB : EqBool type :=
      {
        eqb := typ_eqb
      }.
    Next Obligation.
      revert y H0; solve_eqb_liebniz x.
    Defined.
    Next Obligation.
      solve_eqb_refl.
    Defined.

  End CorpsTypes.

  Section CorpsTerms.

    Inductive expr : Type :=
      var : nat -> expr
    | uu : expr
    | atE (p : PName) (e : expr) : expr
    | letAt (p : PName) (e1 e2 : expr) : expr
    | pair (e1 e2 : expr) : expr
    | pi1 (e : expr)
    | pi2 (e : expr)
    | inl (e : expr)
    | inr (e : expr)
    | caseE (e1 e2 e3 : expr)
    | efql (e : expr) (* ex falso quod libet; exfalso is taken by coq *)
    | lam (t : type) (e : expr)
    | appE (e1 e2 : expr)
    | send (e : expr) (seen : nat) (m : mod) (p : PName) (q : PName)
    | up (e : expr)(seen : nat) (m : mod) (p : PName)
    | down (e : expr) (seen : nat) (m : mod) (p : PName).

    Fixpoint expr_eqb (e1 e2 : expr) : bool :=
      match e1, e2 with
      | var n, var m => eqb n m
      | uu, uu => true
      | atE p e1, atE q e2 => eqb p q && expr_eqb e1 e2
      | letAt p e11 e12, letAt q e21 e22 => eqb p q && expr_eqb e11 e21 && expr_eqb e12 e22
      | pair e11 e12, pair e21 e22 => expr_eqb e11 e21 && expr_eqb e12 e22
      | pi1 e1, pi1 e2 => expr_eqb e1 e2
      | pi2 e1, pi2 e2 => expr_eqb e1 e2
      | inl e1, inl e2 => expr_eqb e1 e2
      | inr e1, inr e2 => expr_eqb e1 e2
      | caseE e11 e12 e13, caseE e21 e22 e23 =>
          expr_eqb e11 e21 && expr_eqb e12 e22 && expr_eqb e13 e23
      | efql e1, efql e2 => expr_eqb e1 e2
      | lam t1 e1, lam t2 e2 => eqb t1 t2 && expr_eqb e1 e2
      | appE e11 e12, appE e21 e22 => expr_eqb e11 e21 && expr_eqb e12 e22
      | send e1 seen1 m1 p1 q1, send e2 seen2 m2 p2 q2 =>
          expr_eqb e1 e2 && eqb seen1 seen2 && eqb m1 m2&& eqb p1 p2 && eqb q1 q2
      | up e1 seen1 m1 p1, up e2 seen2 m2 p2 =>
          expr_eqb e1 e2 && eqb seen1 seen2 && eqb m1 m2 && eqb p1 p2
      | down e1 seen1 m1 p1, down e2 seen2 m2 p2 =>
          expr_eqb e1 e2 && eqb seen1 seen2 && eqb m1 m2 && eqb p1 p2
      | _, _ => false 
      end.

    Theorem expr_eqb_liebniz : forall x y, expr_eqb x y = true -> x = y.
    Proof using.
      intro x; solve_eqb_liebniz x.
    Qed.

    Theorem expr_eqb_refl : forall x, expr_eqb x x = true.
    Proof using.
      intro x; solve_eqb_refl.
    Qed.
    
    #[global] Instance exprEqBool : EqBool expr :=
      {
        eqb := expr_eqb;
        eqb_liebniz := expr_eqb_liebniz;
        eqb_refl := expr_eqb_refl;
      }.

  End CorpsTerms.

  Section UncondRenaming.

    Definition urenaming : Type := nat -> nat.

    Definition id_urenaming : urenaming := fun n => n.

    Definition urenup (ξ : urenaming) : urenaming :=
      fun n =>
        match n with
        | 0 => 0
        | S n  => S (ξ n)
        end.
        
    Lemma urenup_ext : forall (ξ1 ξ2 : urenaming),
        (forall n, ξ1 n = ξ2 n) ->
        forall n, (urenup ξ1) n = (urenup ξ2) n.
    Proof using.
      intros ξ1 ξ2 ext_eq n; destruct n; cbn; [| rewrite ext_eq]; reflexivity.
    Qed.

    Lemma urenup_id : forall n, urenup id_urenaming n = n.
    Proof using.
      intros n; destruct n; cbn; reflexivity.
    Qed.

    Lemma urenup_id_up_to : forall ξ k,
        (forall n, n < k -> ξ n = n) ->
        forall n, n < S k -> urenup ξ n = n.
    Proof using.
      intros ξ k ren_id n n_lt_Sk.
      destruct n; cbn; try reflexivity.
      apply PeanoNat.lt_S_n in n_lt_Sk.
      rewrite ren_id; auto.
    Qed.

    
    Lemma urenup_fusion : forall ξ1 ξ2 : urenaming,
      forall n, (fun n => urenup ξ2 (urenup ξ1 n)) n = urenup (fun n => ξ2 (ξ1 n)) n.
    Proof using.
      intros ξ1 ξ2 n; destruct n; cbn; reflexivity.
    Qed.

    Fixpoint uren (e : expr) (ξ : urenaming) : expr :=
      match e with
      | var x => var (ξ x)
      | uu => uu
      | atE p e => atE p (uren e ξ)
      | letAt p e1 e2 => letAt p (uren e1 ξ) (uren e2 (urenup ξ))
      | pair e1 e2 => pair (uren e1 ξ) (uren e2 ξ)
      | pi1 e => pi1 (uren e ξ)
      | pi2 e => pi2 (uren e ξ)
      | inl e => inl (uren e ξ)
      | inr e => inr (uren e ξ)
      | caseE e1 e2 e3 => caseE (uren e1 ξ) (uren e2 (urenup ξ)) (uren e3 (urenup ξ))
      | efql e => efql (uren e ξ)
      | lam t e => lam t (uren e (urenup ξ))
      | appE e1 e2 => appE (uren e1 ξ) (uren e2 ξ)
      | send e seen m p q => send (uren e ξ) seen m p q
      | up e seen m p => up (uren e ξ) seen m p
      | down e seen m p => down (uren e ξ) seen m p
      end.
    
    Lemma uren_ext : forall (ξ1 ξ2 : urenaming),
        (forall n, ξ1 n = ξ2 n) ->
        forall e, uren e ξ1 = uren e ξ2.
    Proof using.
      intros ξ1 ξ2 ext_eq e; revert ξ1 ξ2 ext_eq; induction e; intros ξ1 ξ2 ext_eq; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [ H : forall n, ?f n = ?g n |- context [?f ?n]] => rewrite (H n)
          | [ IH : forall ξ1 ξ2, (forall n, ξ1 n = ξ2 n) -> uren ?e ξ1 = uren ?e ξ2,
                H : forall n, ?f n = ?g n |- context[uren ?e ?f]] =>
              rewrite (IH f g H)
          | [H : forall n, ?f n = ?g n |- context[urenup ?f]] =>
              pose proof (urenup_ext f g H)
          end.
    Qed.

    Lemma uren_id : forall e, uren e id_urenaming = e.
    Proof using.
      intros e; induction e; unfold id_urenaming in *; cbn;
        repeat match goal with
          | [|- ?a = ?a ] => reflexivity
          | [ IH : uren ?e (fun n => n) = ?e |- context[uren ?e (fun n => n)]] => rewrite IH
          | [ |- context[uren _ (urenup (fun n => n))]] =>
              rewrite uren_ext with (ξ1 := urenup (fun n => n)) (ξ2 := fun n => n); [| apply urenup_id]
          end.
    Qed.

    Lemma uren_fusion : forall e ξ1 ξ2, uren (uren e ξ1) ξ2 = uren e (fun n => ξ2 (ξ1 n)).
      intro e; induction e; intros ξ1 ξ2; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [ IH : forall ξ1 ξ2, uren (uren ?e ξ1) ξ2 = uren ?e (fun n => ξ2 (ξ1 n))
                            |-  context[uren (uren ?e ?f) ?g]] =>
              rewrite (IH f g)
          | [ |- context[uren ?e (fun n => urenup ?g (urenup ?f n))]] =>
              rewrite (uren_ext (fun n => urenup g (urenup f n)) (urenup (fun n => g (f n)))
                         (urenup_fusion f g) e)
          end.
    Qed.
End UncondRenaming. 
    
  Section Renaming.

    Definition renaming : Type := nat -> nat * (mod * mod).

    Definition id_renaming (ξ : renaming) : Prop := forall n, fst (ξ n) = n.

    Definition id_renaming_up_to (ξ : renaming) (m : nat) : Prop := forall n, n < m -> fst (ξ n) = n.

    Lemma id_renaming_is_up_to : forall ξ, id_renaming ξ <-> forall m, id_renaming_up_to ξ m.
    Proof using.
      intros ξ; split; intros id_ren.
      -  intros m n n_lt_m; apply id_ren.
      - intro n; apply (id_ren (S n)); auto.
    Qed.

    Definition renup (ξ : renaming) : renaming :=
      fun n =>
        match n with
        | 0 => (0, (base, base))
        | S n  => match ξ n with
                 | (n', (m, locks)) => (S n', (m, locks))
                 end
        end.

    Definition renlock (ξ : renaming) (l : mod) :=
      fun n =>
        match ξ n with
        | (n, (m, locks)) => (n, (m, mod_app locks l))
        end.
        
    Lemma renup_ext : forall (ξ1 ξ2 : renaming),
        (forall n, ξ1 n = ξ2 n) ->
        forall n, (renup ξ1) n = (renup ξ2) n.
    Proof using.
      intros ξ1 ξ2 ext_eq n; destruct n; cbn; [| rewrite ext_eq]; reflexivity.
    Qed.

    Lemma renlock_ext : forall (ξ1 ξ2 : renaming) (m : mod),
        (forall n, ξ1 n = ξ2 n) ->
        forall n, renlock ξ1 m n = renlock ξ2 m n.
    Proof using.
      intros ξ1 ξ2 m ext_eq n; unfold renlock; destruct (ξ1 n) as [x1 [m1 l1]] eqn:eq1; destruct (ξ2 n) as [x2 [m2 l2]] eqn:eq2.
      specialize (ext_eq n); rewrite eq1 in ext_eq; rewrite eq2 in ext_eq; inversion ext_eq; subst.
      reflexivity.
    Qed.

    Lemma renup_id : forall ξ, id_renaming ξ -> id_renaming (renup ξ).
    Proof using.
      intros ξ id_ren n; destruct n; cbn; [reflexivity|]; destruct (ξ n) as [n' [m locks]] eqn:eq; cbn.
      specialize (id_ren n); rewrite eq in id_ren; cbn in id_ren; auto.
    Qed.

    Lemma renup_id_up_to : forall ξ m, id_renaming_up_to ξ m -> id_renaming_up_to (renup ξ) (S m).
    Proof using.
      intros ξ m id_ren n n_lt_Sm.
      destruct n; cbn; [reflexivity | cbn].
      destruct (ξ n) as [n' [m' locks]] eqn:eq; cbn.
      pose proof (PeanoNat.lt_S_n n m n_lt_Sm) as n_lt_m.
      specialize (id_ren n n_lt_m).
      rewrite eq in id_ren; cbn in id_ren; subst. reflexivity.
    Qed.

    Lemma renlock_id : forall ξ l, id_renaming ξ -> id_renaming (renlock ξ l).
    Proof using.
      intros ξ l id_ren n; unfold renlock; destruct (ξ n) as [x [m locks]] eqn:eq; cbn.
      specialize (id_ren n); rewrite eq in id_ren; cbn in id_ren; exact id_ren.
    Qed.

    Lemma renlock_id_up_to : forall ξ l k, id_renaming_up_to ξ k -> id_renaming_up_to (renlock ξ l) k.
    Proof using.
      intros ξ l k ren_id n n_lt_k; unfold renlock; destruct (ξ n) as [x [m locks]] eqn:eq; cbn.
      specialize (ren_id n n_lt_k); rewrite eq in ren_id; cbn in ren_id; exact ren_id.
    Qed.
    
    (* Lemma renup_fusion : forall ξ1 ξ2 : renaming, *)
    (*   forall n, (fun n => renup ξ2 (renup ξ1 n)) n = renup (fun n => ξ2 (ξ1 n)) n. *)
    (* Proof using. *)
    (*   intros ξ1 ξ2 n; destruct n; cbn; reflexivity. *)
    (* Qed. *)

    Fixpoint ren (e : expr) (ξ : renaming) : expr :=
      match e with
      | var x =>
          match ξ x with
          | (y, (m, locks)) =>
              if eqb m locks
              then var y
              else var x
          end
      | uu => uu
      | atE p e => atE p (ren e (renlock ξ p))
      | letAt p e1 e2 => letAt p (ren e1 ξ) (ren e2 (renup ξ))
      | pair e1 e2 => pair (ren e1 ξ) (ren e2 ξ)
      | pi1 e => pi1 (ren e ξ)
      | pi2 e => pi2 (ren e ξ)
      | inl e => inl (ren e ξ)
      | inr e => inr (ren e ξ)
      | caseE e1 e2 e3 => caseE (ren e1 ξ) (ren e2 (renup ξ)) (ren e3 (renup ξ))
      | efql e => efql (ren e ξ)
      | lam t e => lam t (ren e (renup ξ))
      | appE e1 e2 => appE (ren e1 ξ) (ren e2 ξ)
      | send e seen m p q => send (ren e ξ) seen m p q
      | up e seen m p => up (ren e ξ) seen m p
      | down e seen m p => down (ren e ξ) seen m p
      end.
    
    Lemma ren_ext : forall (ξ1 ξ2 : renaming),
        (forall n, ξ1 n = ξ2 n) ->
        forall e, ren e ξ1 = ren e ξ2.
    Proof using.
      intros ξ1 ξ2 ext_eq e; revert ξ1 ξ2 ext_eq; induction e; intros ξ1 ξ2 ext_eq; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [ H : forall n, ?f n = ?g n |- context [?f ?n]] => rewrite (H n)
          | [ IH : forall ξ1 ξ2, (forall n, ξ1 n = ξ2 n) -> ren ?e ξ1 = ren ?e ξ2,
                H : forall n, ?f n = ?g n |- context[ren ?e ?f]] =>
              rewrite (IH f g H)
          | [H : forall n, ?f n = ?g n |- context[renup ?f]] =>
              pose proof (renup_ext f g H)
          | [H : forall n, ?f n = ?g n |- context[renlock ?f ?l]] =>
              pose proof (renlock_ext f g l H)
          end.
    Qed.

    Lemma ren_id : forall e ξ, id_renaming ξ -> ren e ξ = e.
    Proof using.
      intros e; induction e; intros  ξ id_ren; cbn;
        repeat match goal with
          | [|- ?a = ?a ] => reflexivity
          | [ IH : forall ξ, id_renaming ξ -> ren ?e ξ = ?e, H : id_renaming ?ξ |- context[ren ?e ?ξ]] =>
              rewrite (IH ξ H)
          | [ H : id_renaming ?ξ |- context[renup ?ξ]] =>
              lazymatch goal with
              | [_ : id_renaming (renup ξ) |- _ ] => fail
              | _ => pose proof (renup_id H)
              end
          | [ H : id_renaming ?ξ |- context[renlock ?ξ ?l]] =>
              lazymatch goal with
              | [_ : id_renaming (renlock ξ l) |- _ ] => fail
              | _ => pose proof (renlock_id l H)
              end
          end.
      destruct (ξ n) as [y [m l]] eqn:eq; eq_bool; subst; [| reflexivity].
      specialize (id_ren n); rewrite eq in id_ren; auto.
    Qed.

    (* Lemma ren_fusion : forall e ξ1 ξ2, ren (ren e ξ1) ξ2 = ren e (fun n => ξ2 (ξ1 n)). *)
    (*   intro e; induction e; intros ξ1 ξ2; cbn; *)
    (*     repeat match goal with *)
    (*       | [ |- ?a = ?a ] => reflexivity *)
    (*       | [ IH : forall ξ1 ξ2, ren (ren ?e ξ1) ξ2 = ren ?e (fun n => ξ2 (ξ1 n)) *)
    (*                         |-  context[ren (ren ?e ?f) ?g]] => *)
    (*           rewrite (IH f g) *)
    (*       | [ |- context[ren ?e (fun n => renup ?g (renup ?f n))]] => *)
    (*           rewrite (ren_ext (fun n => renup g (renup f n)) (renup (fun n => g (f n))) *)
    (*                      (renup_fusion f g) e) *)
    (*       end. *)
    (* Qed. *)

  End Renaming.

  Section Substitution.

    Definition substitution : Type := nat -> expr * (mod * mod).
    Definition id_substitution (σ : substitution) : Prop :=
      forall n, fst (σ n) = var n.

    Definition substup (σ : substitution) : substitution :=
      fun n =>
        match n with
        | 0 => (var 0, (base, base))
        | S n => match σ n with
                | (e, (m, l)) => (uren e S, (m, l))
                end
        end.

    Lemma substup_ext : forall σ1 σ2,
        (forall n, σ1 n = σ2 n) ->
        forall n, substup σ1 n = substup σ2 n.
    Proof using.
      intros σ1 σ2 ext_eq n; destruct n; cbn; [|rewrite ext_eq]; try reflexivity.
    Qed.

    Lemma id_substup :
      forall σ, id_substitution σ -> id_substitution (substup σ).
    Proof using.
      intros σ id_subst n; destruct n; cbn; [reflexivity|].
      destruct (σ n) as [e [m l]] eqn:eq; cbn.
      specialize (id_subst n); rewrite eq in id_subst; cbn in id_subst; subst; cbn.
      eq_bool; reflexivity.
    Qed.

    Definition id_substitution_up_to (σ : substitution) (k : nat) : Prop :=
      forall n, n < k -> fst (σ n) = var n.

    Lemma id_substitution_is_up_to : forall σ, id_substitution σ <-> forall k, id_substitution_up_to σ k.
    Proof using.
      intros σ; split; intro id_subst; [ intros k n n_lt_k  | intro n; specialize (id_subst (S n))]; apply id_subst; auto.
    Qed.

    Lemma substup_id_below : forall σ k, id_substitution_up_to σ k -> id_substitution_up_to (substup σ) (S k).
    Proof using.
      intros σ k id_subst n n_lt_k; destruct n; cbn; [reflexivity|].
      apply PeanoNat.lt_S_n in n_lt_k.
      destruct (σ n) as [e [m l]] eqn:eq; cbn.
      specialize (id_subst n n_lt_k); rewrite eq in id_subst; cbn in id_subst; subst; reflexivity.
    Qed.

    Definition substlock (σ : substitution) (l : mod) : substitution :=
      fun n =>
        match σ n with
        | (e, (m, locks)) => (e, (m, mod_app locks l))
        end.

    Lemma substlock_ext : forall σ1 σ2 l,
        (forall n, σ1 n = σ2 n) ->
        forall n, substlock σ1 l n = substlock σ2 l n.
    Proof using.
      intros σ1 σ2 l ext_eq n; unfold substlock; rewrite ext_eq; reflexivity.
    Qed.

    Lemma id_substlock : forall σ l, id_substitution σ -> id_substitution (substlock σ l).
    Proof using.
      intros σ l id_subst n; unfold substlock; destruct (σ n) as [e [m locks]] eqn:eq.
      specialize (id_subst n); rewrite eq in id_subst; cbn in id_subst; subst; reflexivity.
    Qed.

    Fixpoint subst (e : expr) (σ : substitution) : expr :=
      match e with
      | var x =>
          match σ x with
          | (e, (m, l)) =>
              if eqb m l
              then e
              else var x
          end
      | uu => uu
      | atE p e => atE p (subst e (substlock σ p))
      | letAt p e1 e2 => letAt p (subst e1 σ) (subst e2 (substup σ))
      | pair e1 e2 => pair (subst e1 σ) (subst e2 σ)
      | pi1 e => pi1 (subst e σ)
      | pi2 e => pi2 (subst e σ)
      | inl e => inl (subst e σ)
      | inr e => inr (subst e σ)
      | caseE e1 e2 e3 =>
          caseE (subst e1 σ) (subst e2 (substup σ)) (subst e3 (substup σ))
      | efql e => efql (subst e σ)
      | lam t e => lam t (subst e (substup σ))
      | appE e1 e2 => appE (subst e1 σ) (subst e2 σ)
      | send e seen m p q => send (subst e σ) seen m p q
      | up e seen m p => up (subst e σ) seen m p
      | down e seen m p => down (subst e σ) seen m p
      end.

    Lemma subst_ext : forall σ1 σ2,
        (forall n, σ1 n = σ2 n) ->
        forall e, subst e σ1 = subst e σ2.
    Proof using.
      intros σ1 σ2 ext_eq e; revert σ1 σ2 ext_eq; induction e; intros σ1 σ2 ext_eq; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [ H : forall n, ?f n = ?g n |- context[?f ?n]] => rewrite (H n)
          | [ IH : forall σ1 σ2, (forall n, σ1 n = σ2 n) -> subst ?e σ1 = subst ?e σ2,
                H : forall n, ?f n = ?g n |- context[subst ?e ?f]] =>
              rewrite (IH f g H)
          | [ H : forall n, ?f n = ?g n |- context[substup ?f] ] =>
              pose proof (substup_ext f g H)
          | [ H : forall n, ?f n = ?g n |- context[substlock ?f ?l] ] =>
              pose proof (substlock_ext f g l H)
          end.
    Qed.

    Lemma subst_id : forall e σ, id_substitution σ -> subst e σ = e.
    Proof using.
      intros e; induction e; intros σ id_subst; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [ |- context[id_substitution _]] => unfold id_substitution; cbn
          | [ H : id_substitution ?f, IH : forall σ, id_substitution σ -> subst ?e σ = ?e |- context[subst ?e ?f]] =>
              rewrite (IH f H)
          | [ H : id_substitution ?σ |- context[(substup ?σ)]] =>
              lazymatch goal with
              | [ _ : id_substitution (substup σ) |- _ ] => fail
              | _ => pose proof (id_substup H)
              end
          | [ H : id_substitution ?σ |- context[(substlock ?σ ?l)]] =>
              lazymatch goal with
              | [ _ : id_substitution (substlock σ l) |- _ ] => fail
              | _ => pose proof (@id_substlock σ l H)
              end
          end.
      - destruct (σ n) as [e [m l]] eqn:eq; eq_bool; subst; try reflexivity.
        specialize (id_subst n); rewrite eq in id_subst; cbn in id_subst; subst; reflexivity.
    Qed.

    Definition compat_vars : forall {A : Type}, (nat -> A * (mod * mod)) -> (nat -> A * (mod * mod)) -> Prop :=
      fun A f1 f2 => forall n, snd (f1 n) = snd (f2 n).

    Definition ren_as_subst (ξ : renaming) (σ : substitution) :=
      forall n, fst (σ n) = var (fst (ξ n)) /\ snd (σ n) = snd (ξ n).

    Definition ren_to_subst (ξ : renaming) : substitution :=
      fun n =>
        match ξ n with
        | (x, (m, l)) => (var x, (m, l))
        end.

    Lemma ren_to_subst_as_subst : forall ξ, ren_as_subst ξ (ren_to_subst ξ).
    Proof using.
      intros ξ n; unfold ren_to_subst; destruct (ξ n) as [x [m l ]]; cbn; split; reflexivity.
    Qed.

    Lemma ren_to_subst_unique : forall ξ σ, ren_as_subst ξ σ -> forall n, σ n = ren_to_subst ξ n.
    Proof using.
      intros ξ σ ras n; unfold ren_to_subst; destruct (ξ n) as [x [m l]] eqn:eq.
      destruct (ras n) as [ras1 ras2]; rewrite eq in ras1; rewrite eq in ras2; cbn in *.
      destruct (σ n) as [e [m' l']] eqn:eq'; cbn in *; inversion ras2; subst; reflexivity.
    Qed.

    Lemma ren_as_subst_up : forall ξ σ, ren_as_subst ξ σ -> ren_as_subst (renup ξ) (substup σ).
    Proof using.
      intros ξ σ ras n; destruct n; cbn; auto.
      destruct (σ n) as [e [m1 l1]] eqn:eq1; destruct (ξ n) as [x [m2 l2]] eqn:eq2; cbn.
      destruct (ras n) as [ras1 ras2]; rewrite eq1 in ras1; rewrite eq2 in ras1; rewrite eq1 in ras2; rewrite eq2 in ras2;
        cbn in ras1; cbn in ras2; subst; cbn.
      inversion ras2; subst.
      split; reflexivity.
    Qed.

    Lemma ren_as_subst_lock : forall ξ σ l, ren_as_subst ξ σ -> ren_as_subst (renlock ξ l) (substlock σ l).
    Proof using.
      intros ξ σ l ras n; unfold renlock; unfold substlock.
      destruct (σ n) as [e [m1 l1]] eqn:eq1; destruct (ξ n) as [x [m2 l2]] eqn:eq2; cbn.
      destruct (ras n) as [ras1 ras2]; rewrite eq1 in ras1; rewrite eq2 in ras1; rewrite eq1 in ras2; rewrite eq2 in ras2;
        cbn in ras1; cbn in ras2; subst; cbn.
      inversion ras2; subst.
      split; reflexivity.
    Qed.

    Lemma ren_subst : forall e ξ σ,
        ren_as_subst ξ σ ->
        ren e ξ = subst e σ.
    Proof using.
      intro e; induction e; intros ξ σ ras; cbn;
        repeat match goal with
          | [ |- ?a = ?a ] => reflexivity
          | [H : ren_as_subst ?ξ ?σ, IH : forall ξ σ, ren_as_subst ξ σ -> ren ?e ξ = subst ?e σ |- context[ren ?e ?ξ]] =>
              rewrite (IH ξ σ H)
          | [ H : ren_as_subst ?ξ ?σ |- context[substlock ?σ ?p]] =>
              lazymatch goal with
              | [ _ : ren_as_subst (renlock ξ p) (substlock σ p) |- _ ] => fail
              | _ => pose proof (ren_as_subst_lock p H)
              end
          | [ H : ren_as_subst ?ξ ?σ |- context[substup ?σ]] =>
              lazymatch goal with
              | [ _ : ren_as_subst (renup ξ) (substup σ) |- _ ] => fail
              | _ => pose proof (ren_as_subst_up H)
              end
          end.
      - destruct (ξ n) as [x [m l]] eqn:eq1; destruct (σ n) as [e [m' l']] eqn:eq2.
        destruct (ras n) as [ras1 ras2]; rewrite eq1 in ras1; rewrite eq2 in ras1; cbn in ras1;
          rewrite eq1 in ras2; rewrite eq2 in ras2; cbn in ras2; inversion ras2;
          eq_bool; subst; reflexivity.
    Qed.
    
    (* Lemma ren_subst_fusion : forall e ξ σ, *)
    (*     subst (ren e ξ) σ = subst e (fun n => σ (ξ n)). *)
    (* Proof using. *)
    (*   intro e; induction e; intros ξ σ; cbn; *)
    (*     repeat match goal with *)
    (*       | [ |- ?a = ?a ] => reflexivity *)
    (*       | [ IH : forall ξ σ, subst (ren ?e ξ) σ = subst ?e (fun n => σ (ξ n)) *)
